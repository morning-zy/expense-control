# ============================================================
#  本地开发配置模板
#  使用方法：
#    1. 复制本文件为 application-dev.yml
#    2. 填入自己的数据库账号密码
#    3. application-dev.yml 已在 .gitignore 中，不会被提交
# ============================================================
spring:
  datasource:
    # 建议为应用单独建账号，只授予业务库的 DML 权限，不要直接用 root：
    #   CREATE USER 'expense_app'@'localhost' IDENTIFIED BY '你的密码';
    #   GRANT SELECT, INSERT, UPDATE, DELETE ON `expense_control`.* TO 'expense_app'@'localhost';
    username: expense_app
    password: "改成你自己的密码"
